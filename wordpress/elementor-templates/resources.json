    {
     "id": "10f778",
     "elType": "widget",
     "settings": {
      "html": "<div class=\"grid paths\"><article class=\"card\"><h3><a href=\"/resources/unschooling/\">Unschooling</a></h3><p>Self-directed learning. Books to retrain the mentor's mind about what education can be.</p>\n</article><article class=\"card\"><h3><a href=\"/resources/eclectic/\">Eclectic</a></h3><p>Mix and match. Writing tools, coding, history, STEM, online platforms and study tools, each with a price note.</p>\n</article><article class=\"card\"><h3><a href=\"/resources/structured-programs/\">Structured programs</a></h3><p>School-at-home curricula and online schools compared on grades, accreditation, diplomas, live classes and cost.</p>\n</article></div>\n"
     },
