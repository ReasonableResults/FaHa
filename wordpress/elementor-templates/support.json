    {
     "id": "103dde",
     "elType": "widget",
     "settings": {
      "title": "Any amount helps us achieve our goals.",
      "header_size": "h1"
     },
     "elements": [],
     "widgetType": "heading"
    },
    {
     "id": "105ccd",
     "elType": "widget",
     "settings": {
      "editor": "<p class=\"lede\">In order to align better with our goal of access for all, FaHa has eliminated dues. We welcome charitable contributions from those that are in a position to give. The organization provides resources for event organizers as well as micro-scholarships for families that express a need.</p>"
     },
     "elements": [],
     "widgetType": "text-editor"
    },
    {
     "id": "107bbc",
     "elType": "widget",
     "settings": {
      "text": "Donate on Zeffy",
      "link": {
       "url": "https://www.zeffy.com/en-US/donation-form/ongoing-support-2",
       "is_external": "on"
      },
      "_css_classes": "btn"
     },
     "elements": [],
     "widgetType": "button"
    }
   ],
   "isInner": false
  },
  {
   "id": "11b112",
   "elType": "container",
   "settings": {
    "content_width": "boxed",
